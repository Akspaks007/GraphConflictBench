# Optional providers. The CLI loads the repository .env with override=False.
# Copy to .env locally; never commit real credentials. Shell variables take precedence.
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional ordered comma-separated list. A populated list takes precedence over GROQ_API_KEY.
GROQ_API_KEYS=
OPENAI_API_KEY=
# Only used by the OpenAI provider.
OPENAI_BASE_URL=https://api.openai.com/v1

